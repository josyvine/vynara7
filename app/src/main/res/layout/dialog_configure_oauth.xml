<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Configure GitHub OAuth App"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="To use Device Flow or official OAuth with your own GitHub registered App, enter your GitHub Client ID and Client Secret (from github.com/settings/developers):"
        android:textColor="#9CA3AF"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="20dp" />

    <!-- Client ID Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Client ID"
        android:textColor="#D1D5DB"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/et_oauth_client_id"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_input_field"
        android:hint="Ov23lijUer4XCyoGdmvw"
        android:textColorHint="#4B5563"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:paddingHorizontal="12dp"
        android:singleLine="true"
        android:inputType="textNoSuggestions"
        android:layout_marginBottom="16dp" />

    <!-- Client Secret Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Client Secret"
        android:textColor="#D1D5DB"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/et_oauth_client_secret"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_input_field"
        android:hint="ab8824982ae4d1d613b31cfc6ae4afc1d83c2c9d"
        android:textColorHint="#4B5563"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:paddingHorizontal="12dp"
        android:singleLine="true"
        android:inputType="textPassword"
        android:layout_marginBottom="24dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btn_oauth_cancel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#9CA3AF"
            android:backgroundTint="#00000000"
            style="?android:attr/borderlessButtonStyle"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_oauth_save"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Save Credentials"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#2563EB"
            app:cornerRadius="8dp" />
    </LinearLayout>

</LinearLayout>