<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="24dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔑"
            android:textSize="20sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GitHub Device Flow"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter this user code on GitHub to authorize Vynara Workspace:"
        android:textColor="#9CA3AF"
        android:textSize="13sp"
        android:layout_marginBottom="16dp" />

    <!-- User Code Display Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center"
        android:background="@drawable/bg_input_field"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tv_device_user_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="---- ----"
            android:textColor="#3B82F6"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />
    </LinearLayout>

    <!-- Verification URL -->
    <TextView
        android:id="@+id/tv_device_verification_url"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Verification URL: https://github.com/login/device"
        android:textColor="#6B7280"
        android:textSize="12sp"
        android:layout_marginBottom="20dp" />

    <!-- Open Page Button -->
    <Button
        android:id="@+id/btn_open_github_verification"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Open GitHub Verification Page"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="#2DA44E"
        android:layout_marginBottom="20dp"
        app:cornerRadius="8dp" />

    <!-- Polling Progress Indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="20dp">

        <ProgressBar
            android:id="@+id/progress_device_polling"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminate="true"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/tv_device_status_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Waiting for authorization on GitHub..."
            android:textColor="#D1D5DB"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Cancel Button -->
    <Button
        android:id="@+id/btn_device_cancel"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Cancel"
        android:textAllCaps="false"
        android:textColor="#9CA3AF"
        android:backgroundTint="#1F2937"
        app:cornerRadius="8dp" />

</LinearLayout>